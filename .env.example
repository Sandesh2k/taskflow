# Local development values
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/taskflow
AUTH_SECRET=change-me-to-a-long-random-secret
NEXTAUTH_SECRET=change-me-to-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_URL_INTERNAL=http://localhost:3000

# For Vercel deployment, set the same values in Project Settings > Environment Variables.
# Use a production URL such as https://your-app.vercel.app for NEXTAUTH_URL.
